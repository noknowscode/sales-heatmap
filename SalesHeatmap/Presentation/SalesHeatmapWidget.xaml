<UserControl x:Class="SalesHeatmap.Presentation.SalesHeatmapWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Brushes the code hands to cells and change labels. Their colours are bound to the theme, so a theme or
             palette change recolours them in place: the heat is the Primary role (each cell's strength is its
             opacity), a fall is the Error role, a rise is the app's PositiveColor (App.xaml; no palette role). -->
        <SolidColorBrush x:Key="HeatCellBrush" Color="{ThemeResource PrimaryColor}"/>
        <SolidColorBrush x:Key="RiseBrush" Color="{ThemeResource PositiveColor}"/>
        <SolidColorBrush x:Key="FallBrush" Color="{ThemeResource ErrorColor}"/>
    </UserControl.Resources>

    <Border CornerRadius="{StaticResource Radius400CornerRadius}"
            BorderBrush="{ThemeResource OutlineBrush}"
            BorderThickness="2"
            Background="{ThemeResource SurfaceBrush}"
            Padding="{StaticResource Space300Thickness}">
        <Grid RowSpacing="{StaticResource Space300}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="SALES OVERVIEW"
                           Style="{StaticResource TitleMedium}"
                           Foreground="{ThemeResource OnSurfaceBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space100}" VerticalAlignment="Center">
                    <Ellipse x:Name="LiveIndicator"
                             Width="8" Height="8"
                             VerticalAlignment="Center"
                             Fill="{ThemeResource PrimaryBrush}"/>
                    <TextBlock Text="LIVE"
                               Style="{StaticResource LabelMedium}"
                               Foreground="{ThemeResource PrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{ThemeResource BackgroundBrush}"
                    CornerRadius="{StaticResource Radius200CornerRadius}"
                    Padding="{StaticResource Space150Thickness}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="1">
                <Grid x:Name="HeatmapGrid" HorizontalAlignment="Center" />
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="{StaticResource Space400}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                    <StackPanel Spacing="{StaticResource Space050}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="MONTHLY"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="MonthlyValue"
                                   Style="{StaticResource HeadlineSmall}"
                                   Foreground="{ThemeResource OnSurfaceBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space050}">
                            <Path x:Name="MonthlyChangeIcon" Width="8" Height="6" Stretch="Fill" VerticalAlignment="Center"
                                  Data="M0,6 L4,0 L8,6 Z" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform /></Path.RenderTransform>
                            </Path>
                            <TextBlock x:Name="MonthlyChangeValue" Style="{StaticResource LabelMedium}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space050}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="YEARLY"
                                       Style="{StaticResource LabelSmall}"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="YearlyValue"
                                   Style="{StaticResource HeadlineSmall}"
                                   Foreground="{ThemeResource OnSurfaceBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space050}">
                            <Path x:Name="YearlyChangeIcon" Width="8" Height="6" Stretch="Fill" VerticalAlignment="Center"
                                  Data="M0,6 L4,0 L8,6 Z" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform /></Path.RenderTransform>
                            </Path>
                            <TextBlock x:Name="YearlyChangeValue" Style="{StaticResource LabelMedium}"/>
                        </StackPanel>
                    </StackPanel>
            </Grid>

            <Border Grid.Row="3"
                    Background="{ThemeResource SurfaceVariantBrush}"
                    CornerRadius="{StaticResource Radius200CornerRadius}"
                    Padding="{StaticResource Space200Thickness}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="{StaticResource Space150}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="TOP REGIONS"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Los Angeles"
                                       Style="{StaticResource BodyMedium}"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                            <TextBlock x:Name="LAValue"
                                       Grid.Column="1"
                                       Style="{StaticResource TitleSmall}"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       HorizontalAlignment="Right"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space050}">
                            <Path x:Name="LAChangeIcon" Width="8" Height="6" Stretch="Fill" VerticalAlignment="Center"
                                  Data="M0,6 L4,0 L8,6 Z" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform /></Path.RenderTransform>
                            </Path>
                                <TextBlock x:Name="LAChange" Style="{StaticResource LabelMedium}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="New York"
                                       Style="{StaticResource BodyMedium}"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                            <TextBlock x:Name="NYValue"
                                       Grid.Column="1"
                                       Style="{StaticResource TitleSmall}"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       HorizontalAlignment="Right"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space050}">
                            <Path x:Name="NYChangeIcon" Width="8" Height="6" Stretch="Fill" VerticalAlignment="Center"
                                  Data="M0,6 L4,0 L8,6 Z" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform /></Path.RenderTransform>
                            </Path>
                                <TextBlock x:Name="NYChange" Style="{StaticResource LabelMedium}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Canada"
                                       Style="{StaticResource BodyMedium}"
                                       Foreground="{ThemeResource OnSurfaceVariantBrush}"/>
                            <TextBlock x:Name="CAValue"
                                       Grid.Column="1"
                                       Style="{StaticResource TitleSmall}"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       HorizontalAlignment="Right"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space050}">
                            <Path x:Name="CAChangeIcon" Width="8" Height="6" Stretch="Fill" VerticalAlignment="Center"
                                  Data="M0,6 L4,0 L8,6 Z" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform /></Path.RenderTransform>
                            </Path>
                                <TextBlock x:Name="CAChange" Style="{StaticResource LabelMedium}"/>
                            </StackPanel>
                        </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
